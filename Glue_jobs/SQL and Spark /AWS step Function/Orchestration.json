{
  "Comment": "EU-RU Pharma Data Engineering - AWS Glue Workflow",
  "StartAt": "BronzeToSilver",
  "States": {
    "BronzeToSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "eu-pharma-bronze-to-silver",
        "Arguments": {
          "--EU_RAW_BUCKET.$": "$.bucket",
          "--PROCESSED_BUCKET": "eu-pharma-processed",
          "--BATCH_ID.$": "$.batch_id"
        }
      },
      "ResultPath": "$.silver_result",
      "Next": "SilverToGold",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "SilverToGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "eu-pharma-silver-to-gold",
        "Arguments": {
          "--PROCESSED_BUCKET": "eu-pharma-processed",
          "--BATCH_ID.$": "$.batch_id"
        }
      },
      "ResultPath": "$.gold_result",
      "Next": "DataQualityValidation",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "DataQualityValidation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "eu-pharma-data-quality",
        "Arguments": {
          "--EU_RAW_BUCKET.$": "$.bucket",
          "--PROCESSED_BUCKET": "eu-pharma-processed",
          "--BATCH_ID.$": "$.batch_id",
          "--SNS_TOPIC_ARN": "REPLACE_WITH_YOUR_SNS_TOPIC_ARN"
        }
      },
      "ResultPath": "$.quality_result",
      "Next": "NotifySuccess",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "REPLACE_WITH_YOUR_SNS_TOPIC_ARN",
        "Subject": "EU Pharma Pipeline Completed",
        "Message.$": "States.JsonToString($)"
      },
      "End": true
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "REPLACE_WITH_YOUR_SNS_TOPIC_ARN",
        "Subject": "EU Pharma Pipeline Failed",
        "Message.$": "States.JsonToString($)"
      },
      "Next": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "EUPharmaPipelineFailed",
      "Cause": "AWS Glue processing failed after retries"
    }
  }
}
